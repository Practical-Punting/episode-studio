# Never commit secrets or local cruft
.env
*.env

# THE STUDIO'S OWN GOOGLE IDENTITY — service-account keys (3 Aug 2026).
# Written BEFORE any key existed, on purpose: a secret that arrives before its ignore
# rule is a secret that gets committed. The real key lives OUTSIDE this repo, beside
# .env in PP Videos; these patterns exist so a stray copy dropped in here cannot be
# committed by accident. THE RULE IS "never COMMIT a secret", not "never have one".
.secrets/
*service-account*.json
*-sa.json
*-sa-key.json
pp-studio-sa*.json
gcp-key*.json
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini

# engine mock artifacts + logs
engine/.mock/
*.log

# golden_card_test.py's scratch copies of EP11/EP12 — regenerated on every run
.claude/skills/pp-episode-production/scripts/_golden_work/

# plugin build output — regenerated by plugin/pack.py, never committed
plugin/dist/

# smoke_capture caches the rail's source_urls here; it is regenerated with --refresh-corpus
engine/smoke-corpus.json

# the engine's runtime lock — it holds a live pid, so it is never repo content
engine/engine.lock
